# Normalise toutes les fins de ligne en LF, dans le dépôt comme dans la copie de travail,
# quel que soit le réglage core.autocrlf du poste (les scripts shell exigent LF).
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.patch text eol=lf -whitespace

*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.zip  binary
